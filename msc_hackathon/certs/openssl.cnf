[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_req
prompt = no

[req_distinguished_name]
C = IN
ST = Karnataka
L = Bengaluru
O = Nexus Biddings
OU = Thushar Reddy Secure Client Portal
CN = localhost

[v3_req]
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = thushar-reddy.local
IP.1 = 127.0.0.1
IP.2 = 10.2.44.147
